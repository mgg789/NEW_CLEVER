<UserControl x:Class="Clever.View.Controls.HelpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clever.View.Controls"
             xmlns:helps="clr-namespace:Clever.View.Controls.Helps"
             xmlns:panel ="clr-namespace:Clever.View.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="340">
    <UserControl.Resources>
        <Style x:Key="RoundedTabItemH" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{StaticResource git_icon_mof}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" BorderThickness="0,0,0,0" BorderBrush="{StaticResource tc_brk_st}" Margin="0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="2,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource tc_brk_st}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource tc_brk_st}" />
                                <Setter Property="Foreground" Value="{StaticResource git_icon_mot}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="false">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource tc_brk_sf}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource tc_brk_sf}" />
                                <Setter Property="Foreground" Value="{StaticResource git_icon_mof}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="false" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource tc_brk_mot_sf}"/>
                                    <Setter Property="Foreground" Value="{StaticResource git_icon_mot}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="TabGrid"
          SizeChanged="Grid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="TabGrid_1" Grid.Column="0"/>
        <Grid x:Name="TabGrid_2" Grid.Column="2"/>
        <Grid x:Name="TabGrid_3" Grid.Column="4"/>
        <Grid x:Name="TabGrid_4" Grid.Column="6"/>
        <Grid x:Name="TabGrid_5" Grid.Column="8"/>
        <TabControl x:Name="TcHelps"
                    BorderBrush="{StaticResource tc_brk_st}"
                    BorderThickness="1"
                    Background="{StaticResource tc_brk_st}"
                    SelectionChanged="TabControl_SelectionChanged"
                    Grid.Column="0"
                    Grid.ColumnSpan="9">
            <TabItem x:Name="TiBrick"
                     Style="{StaticResource RoundedTabItemH}"
                     Margin="-4,0,0,0"
                     Height="26"
                     Width="{Binding ActualWidth, ElementName=TabGrid_1}"
                     FontFamily="Calibri"
                     FontSize="14"
                     VerticalAlignment="Bottom">
                <TabItem.Header>
                    <Image Source="{StaticResource git_sidebar_icon_brick}" Width="20" Height="20" ToolTip="{Binding Path=GetLocalization[tBrick]}"/>
                </TabItem.Header>
                <helps:EV3Brick Margin="0,0,-1,0"/>
            </TabItem>
            <TabItem x:Name="TiHelp"
                     Style="{StaticResource RoundedTabItemH}"
                     Margin="0,0,0,0"
                     Height="26"
                     Width="{Binding ActualWidth, ElementName=TabGrid_2}"
                     FontFamily="Calibri"
                     FontSize="14"
                     VerticalAlignment="Bottom">
                <TabItem.Header>
                    <Image Source="{StaticResource git_sidebar_icon_help}" Width="20" Height="20" ToolTip="{Binding Path=GetLocalization[tHelp]}"/>
                </TabItem.Header>
                <panel:HelperPanel Margin="0"/>
            </TabItem>
            <TabItem x:Name="TiView"
                     Style="{StaticResource RoundedTabItemH}"
                     Margin="2,0,-2,0"
                     Height="26"
                     Width="{Binding ActualWidth, ElementName=TabGrid_3}"
                     FontFamily="Calibri"
                     FontSize="14"
                     VerticalAlignment="Bottom">
                <TabItem.Header>
                    <Image Source="{StaticResource git_sidebar_icon_file}" Width="20" Height="20" ToolTip="{Binding Path=GetLocalization[tView]}"/>
                </TabItem.Header>
                <helps:View/>
            </TabItem>
            <TabItem x:Name="TiMedia"
                     Style="{StaticResource RoundedTabItemH}"
                     Margin="4,0,-4,0"
                     Height="26"
                     Width="{Binding ActualWidth, ElementName=TabGrid_4}"
                     FontFamily="Calibri"
                     FontSize="14"
                     VerticalAlignment="Bottom"
                     BorderThickness="0"
                     BorderBrush="#00000000">
                <TabItem.Header>
                    <Image Source="{StaticResource git_sidebar_icon_media}" Width="20" Height="20" ToolTip="{Binding Path=GetLocalization[tMedia]}"/>
                </TabItem.Header>
                <panel:MediaPanel/>
            </TabItem>
            <TabItem x:Name="TiGit"
                     Style="{StaticResource RoundedTabItemH}"
                     Margin="6,0,-6,0"
                     Height="26"
                     Width="{Binding ActualWidth, ElementName=TabGrid_5}"
                     FontFamily="Calibri"
                     FontSize="14"
                     VerticalAlignment="Bottom"
                     BorderThickness="0"
                     BorderBrush="#00000000">
                <TabItem.Header>
                    <Image Source="{StaticResource git_sidebar_icon_branch}" Width="20" Height="20" ToolTip="{Binding Path=GetLocalization[tGit]}"/>
                </TabItem.Header>
                <panel:GitPanel/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
