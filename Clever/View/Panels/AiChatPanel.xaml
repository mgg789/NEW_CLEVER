<UserControl x:Class="Clever.View.Panels.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:panels="clr-namespace:Clever.View.Panels"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="340">
    <UserControl.Resources>
        <panels:AiReasoningDisplayConverter x:Key="AiReasoningDisplayConverter"/>
        <Style x:Key="AiIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource git_commit_hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource git_commit_selected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiSendButton" TargetType="Button" BasedOn="{StaticResource AiIconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{StaticResource pnl_clc}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2,-2,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0074D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D6DAE4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="6,1,4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#414659"/>
        </Style>

        <Style x:Key="AiInputTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="Foreground" Value="#414659"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MinLines" Value="1"/>
            <Setter Property="MaxLines" Value="7"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <DataTemplate x:Key="AiMessageTemplate">
            <Grid Margin="8,4">
                <Border Visibility="{Binding UserVisibility}"
                        Background="{StaticResource git_commit_selected}"
                        CornerRadius="8"
                        Padding="9,7"
                        MaxWidth="260"
                        HorizontalAlignment="Right">
                    <FlowDocumentScrollViewer Document="{Binding Document}" IsToolBarVisible="False" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <Border Visibility="{Binding AssistantVisibility}"
                        Background="#00FFFFFF"
                        Padding="2,4"
                        HorizontalAlignment="Stretch">
                    <FlowDocumentScrollViewer Document="{Binding Document}" IsToolBarVisible="False" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <Grid Visibility="{Binding WaitingVisibility}" HorizontalAlignment="Left" Margin="4,5">
                    <Ellipse Width="7" Height="7" Fill="#0A86FF">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="0.28"/>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.65"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.8" To="1.15" Duration="0:0:0.65"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.8" To="1.15" Duration="0:0:0.65"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                    </Ellipse>
                </Grid>

                <ToggleButton Visibility="{Binding WorkSummaryVisibility}"
                              IsChecked="{Binding WorkGroup.IsExpanded, Mode=TwoWay}"
                              Background="#00FFFFFF" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WorkGroup.SummaryText}" Foreground="#737B8D" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                        <Path Grid.Column="1" Data="M2,3 L6,7 10,3" Stroke="#8F98AB" StrokeThickness="1.5" Width="10" Height="7" Stretch="Uniform" Margin="6,0,7,0" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkGroup.IsExpanded}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource git_panel_separator}" VerticalAlignment="Center"/>
                    </Grid>
                </ToggleButton>

                <Grid Visibility="{Binding CompactionVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Height="1" Background="{StaticResource git_panel_separator}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#8F98AB" FontSize="11" Margin="8,0"/>
                    <Border Grid.Column="2" Height="1" Background="{StaticResource git_panel_separator}" VerticalAlignment="Center"/>
                </Grid>

                <Expander Visibility="{Binding CardVisibility}" IsExpanded="False" Background="#00FFFFFF" HorizontalAlignment="Stretch">
                    <Expander.Template>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="#00FFFFFF" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Expander.Template>
                    <Expander.Header>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{Binding IconGeometry}" Stroke="#737B8D" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="#414659" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text="{Binding Status}" Foreground="#9AA2B2" FontSize="10.5" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="M2,3 L6,7 10,3" Stroke="#8F98AB" StrokeThickness="1.5" Width="10" Height="7" Stretch="Uniform" Margin="6,0,2,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Expander.Header>
                    <Border Margin="18,4,0,4" Padding="8,5" Background="#F6F7FA" CornerRadius="5">
                        <FlowDocumentScrollViewer Document="{Binding DetailsDocument}" IsToolBarVisible="False" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="190"/>
                    </Border>
                </Expander>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AiAttachmentTemplate">
            <Border Background="#F1F3F8" CornerRadius="7" Margin="0,0,6,6" Padding="7,5" MaxWidth="150">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" Background="#FFFFFF" CornerRadius="5" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1">
                        <TextBlock Text="{Binding Kind}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" VerticalAlignment="Center" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2"
                            Width="16"
                            Height="16"
                            Padding="0"
                            Background="#00FFFFFF"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#8F98AB" StrokeThickness="1.7" Stretch="Uniform" Width="8" Height="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource git_panel_bgd}"
          AllowDrop="{Binding HasActiveProject}"
          PreviewDragOver="AiChatPanel_PreviewDragOver"
          Drop="AiChatPanel_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1" Padding="7,5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource AiIconButton}" Command="{Binding NewChatCommand}" IsEnabled="{Binding HasActiveProject}" ToolTip="{Binding NewChatText}" ToolTipService.ShowOnDisabled="True">
                        <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#414659" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource AiIconButton}" Command="{Binding HistoryCommand}" IsEnabled="{Binding HasActiveProject}" ToolTip="{Binding HistoryText}" ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ai_icon_history}" Width="17" Height="17"/>
                    </Button>
                </StackPanel>

                <Button x:Name="SettingsButton" Style="{StaticResource AiIconButton}" Command="{Binding ToggleSettingsCommand}" ToolTip="{Binding RobotSettingsText}" HorizontalAlignment="Right">
                    <Image Source="{StaticResource ai_icon_settings}" Width="17" Height="17"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding ChatContentVisibility}">
            <Grid Visibility="{Binding ConversationVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="{Binding LoadMoreTurnsText}" Command="{Binding LoadMoreTurnsCommand}"
                        Visibility="{Binding LoadMoreTurnsVisibility}" Margin="10,6,10,0" Padding="7,3"/>
                <ScrollViewer x:Name="ConversationScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,8" PreviewMouseWheel="ConversationScrollViewer_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource AiMessageTemplate}"/>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding HistoryVisibility}" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="10,8,8,8">
                    <Grid>
                        <TextBlock Text="{Binding HistoryText}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Command="{Binding ReloadHistoryCommand}" Style="{StaticResource AiIconButton}" Width="26" Height="26" Padding="5" HorizontalAlignment="Right" ToolTip="{Binding ReloadText}">
                            <TextBlock Text="↻" FontSize="17" Foreground="#60687A"/>
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding HistorySearchText}"
                             Height="29" Margin="0,7,0,0" Padding="7,4"
                             BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1"
                             Background="#FFFFFF" Foreground="#414659"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding HistoryItems}" Margin="6,0,6,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1" Padding="7,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding EditableTitle, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Padding="0" Background="#00FFFFFF"
                                             Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" FontWeight="SemiBold"/>
                                    <Button Grid.Row="1"
                                            Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Background="#00FFFFFF" BorderThickness="0" Padding="0,2"
                                            HorizontalContentAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding State}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="{Binding ActionsVisibility}">
                                        <Button Content="{Binding DataContext.RenameText, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.RenameHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="5,2" Margin="0,0,4,0"/>
                                        <Button Content="{Binding DataContext.ArchiveText, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.ArchiveHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="5,2" Margin="0,0,4,0"/>
                                        <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="5,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Content="{Binding LoadMoreText}" Command="{Binding LoadMoreHistoryCommand}" Visibility="{Binding LoadMoreVisibility}" Margin="10,4,10,8" Padding="7,4"/>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Visibility="{Binding ProjectRequiredVisibility}" Background="#FFFFFF" Padding="24">
            <TextBlock Text="{Binding ProjectRequiredText}"
                       Foreground="#8F98AB"
                       FontFamily="{StaticResource ui_fontfamily}"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,1,0,0" Padding="8" Visibility="{Binding ComposerVisibility}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AiAttachmentTemplate}" Visibility="{Binding AttachmentVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Visibility="{Binding SlashVisibility}"
                        Background="#F7F8FB" BorderBrush="#BCC3D4" BorderThickness="1"
                        CornerRadius="7" Margin="0,0,0,5" Padding="3" MaxHeight="190">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SlashItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSlashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Opacity="{Binding Opacity}"
                                            BorderThickness="0" Padding="6,4" HorizontalContentAlignment="Stretch">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#00FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource git_commit_selected}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{Binding IconGeometry}" Stroke="#667085" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="#414659" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="{Binding UnavailableReason}" Foreground="#B42318" FontSize="9.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentStatus}" Foreground="#8F98AB" FontSize="11" MaxWidth="110" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" Background="#FFFFFF" CornerRadius="8" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="ComposerTextBox"
                                 Grid.Row="0"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AiInputTextBox}"
                                 IsEnabled="{Binding HasActiveProject}"
                                 ToolTip="{Binding ChatInputTooltip}"
                                 ToolTipService.ShowOnDisabled="True"
                                 PreviewKeyDown="ComposerTextBox_PreviewKeyDown"/>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AiIconButton}" Command="{Binding AttachFileCommand}" IsEnabled="{Binding HasActiveProject}" ToolTip="{Binding ChatInputTooltip}" ToolTipService.ShowOnDisabled="True">
                                    <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#8F98AB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Border Width="18"
                                        Height="18"
                                        Margin="2,0,6,0"
                                        Background="#00FFFFFF"
                                        ToolTip="{Binding ContextTooltip}"
                                        ToolTipService.InitialShowDelay="120"
                                        ToolTipService.ShowDuration="12000"
                                        VerticalAlignment="Center">
                                    <Canvas Width="18" Height="18">
                                        <Ellipse Width="16" Height="16" Canvas.Left="1" Canvas.Top="1" Stroke="#D6DAE4" StrokeThickness="2"/>
                                        <Path Data="{Binding ContextArcGeometry}" Stroke="#0A86FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding ModelSelectorEnabled}" ToolTip="{Binding ModelText}" Style="{StaticResource AiComboBox}"/>
                                <ComboBox ItemsSource="{Binding ReasoningModes}" SelectedItem="{Binding SelectedReasoning}" IsEnabled="{Binding ReasoningSelectorEnabled}" ToolTip="{Binding ReasoningText}" Style="{StaticResource AiComboBox}" MinWidth="58" Width="62">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource AiReasoningDisplayConverter}}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{Binding SpeedTiers}" SelectedItem="{Binding SelectedSpeed}" DisplayMemberPath="DisplayName" IsEnabled="{Binding SpeedSelectorEnabled}" ToolTip="{Binding SpeedText}" Style="{StaticResource AiComboBox}"/>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Style="{StaticResource AiSendButton}"
                                    Command="{Binding SendOrStopCommand}"
                                    IsEnabled="{Binding SendButtonEnabled}"
                                    ToolTip="{Binding SendStopText}">
                                <Grid>
                                    <Image Visibility="{Binding SendIconVisibility}" Source="{StaticResource ai_icon_send}" Width="12" Height="12"/>
                                    <Rectangle Visibility="{Binding StopIconVisibility}" Width="10" Height="10" Fill="White" RadiusX="2" RadiusY="2"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               HorizontalOffset="-258"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA" BorderBrush="#BCC3D4" BorderThickness="1" Padding="12" Width="300">
                <StackPanel>
                    <TextBlock Text="{Binding RobotSettingsText}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding WheelDiameterText}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                            <TextBox Text="{Binding WheelDiameter, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,3" Margin="0,3,0,0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding WheelbaseText}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                            <TextBox Text="{Binding WheelBaseWidth, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,3" Margin="0,3,0,0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,3">
                        <TextBlock Text="{Binding RobotDescriptionText}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding RobotDescriptionCounter}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox Text="{Binding RobotDescription, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="800"
                             Height="92"
                             Padding="6,5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="{StaticResource git_panel_separator}"
                             BorderThickness="1"
                             FontFamily="{StaticResource ui_fontfamily}"
                             FontSize="13"
                             Background="#FFFFFF"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
