<UserControl x:Class="Clever.View.Panels.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="340">
    <UserControl.Resources>
        <Style x:Key="AiIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource git_commit_hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource git_commit_selected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiSendButton" TargetType="Button" BasedOn="{StaticResource AiIconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{StaticResource pnl_clc}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2,-2,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0074D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D6DAE4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="6,1,4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#414659"/>
        </Style>

        <Style x:Key="AiInputTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="Foreground" Value="#414659"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MinLines" Value="1"/>
            <Setter Property="MaxLines" Value="7"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <DataTemplate x:Key="AiMessageTemplate">
            <Grid Margin="8,4">
                <Border Visibility="{Binding UserVisibility}"
                        Background="{StaticResource git_commit_selected}"
                        CornerRadius="8"
                        Padding="9,7"
                        MaxWidth="260"
                        HorizontalAlignment="Right">
                    <FlowDocumentScrollViewer Document="{Binding Document}" IsToolBarVisible="False" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <Border Visibility="{Binding AssistantVisibility}"
                        Background="#00FFFFFF"
                        Padding="2,4"
                        HorizontalAlignment="Stretch">
                    <FlowDocumentScrollViewer Document="{Binding Document}" IsToolBarVisible="False" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AiAttachmentTemplate">
            <Border Background="#F1F3F8" CornerRadius="7" Margin="0,0,6,6" Padding="7,5" MaxWidth="150">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" Background="#FFFFFF" CornerRadius="5" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1">
                        <TextBlock Text="{Binding Kind}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" VerticalAlignment="Center" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2"
                            Width="16"
                            Height="16"
                            Padding="0"
                            Background="#00FFFFFF"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#8F98AB" StrokeThickness="1.7" Stretch="Uniform" Width="8" Height="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource git_panel_bgd}"
          AllowDrop="True"
          PreviewDragOver="AiChatPanel_PreviewDragOver"
          Drop="AiChatPanel_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1" Padding="7,5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource AiIconButton}" Command="{Binding NewChatCommand}" ToolTip="New chat">
                        <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#414659" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource AiIconButton}" Command="{Binding HistoryCommand}" ToolTip="History">
                        <Image Source="{StaticResource ai_icon_history}" Width="17" Height="17"/>
                    </Button>
                </StackPanel>

                <Button x:Name="SettingsButton" Style="{StaticResource AiIconButton}" Command="{Binding ToggleSettingsCommand}" ToolTip="Robot settings" HorizontalAlignment="Right">
                    <Image Source="{StaticResource ai_icon_settings}" Width="17" Height="17"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding ConversationVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,8">
                    <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource AiMessageTemplate}"/>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding HistoryVisibility}" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="12,10,8,8">
                    <TextBlock Text="Chat history" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Command="{Binding ClearHistoryCommand}" Style="{StaticResource AiIconButton}" Width="26" Height="26" Padding="5" HorizontalAlignment="Right" ToolTip="Clear history">
                        <Path Data="M8,7L8,19 M12,7L12,19 M16,7L16,19 M5,5L19,5 M9,5L10,3L14,3L15,5 M6,5L7,21L17,21L18,5" Stroke="#8F98AB" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding HistoryItems}" Margin="6,0,6,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="#00FFFFFF"
                                    BorderThickness="0"
                                    Padding="8"
                                    HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AiAttachmentTemplate}" Visibility="{Binding AttachmentVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" Background="#FFFFFF" CornerRadius="8" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AiInputTextBox}"
                                 ToolTip="Message"/>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AiIconButton}" Command="{Binding AttachFileCommand}" ToolTip="Attach file">
                                    <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#8F98AB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Border Width="18"
                                        Height="18"
                                        Margin="2,0,6,0"
                                        Background="#00FFFFFF"
                                        ToolTip="{Binding ContextTooltip}"
                                        ToolTipService.InitialShowDelay="120"
                                        ToolTipService.ShowDuration="12000"
                                        VerticalAlignment="Center">
                                    <Canvas Width="18" Height="18">
                                        <Ellipse Width="16" Height="16" Canvas.Left="1" Canvas.Top="1" Stroke="#D6DAE4" StrokeThickness="2"/>
                                        <Path Data="M9,2 A7,7 0,1 1,3.4,13.2" Stroke="#0A86FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding SelectorsEnabled}" Style="{StaticResource AiComboBox}"/>
                                <ComboBox ItemsSource="{Binding ReasoningModes}" SelectedItem="{Binding SelectedReasoning}" IsEnabled="{Binding SelectorsEnabled}" Style="{StaticResource AiComboBox}"/>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Style="{StaticResource AiSendButton}"
                                    Command="{Binding SendOrStopCommand}"
                                    IsEnabled="{Binding SendButtonEnabled}"
                                    ToolTip="Send / stop">
                                <Grid>
                                    <Image Visibility="{Binding SendIconVisibility}" Source="{StaticResource ai_icon_send}" Width="12" Height="12"/>
                                    <Rectangle Visibility="{Binding StopIconVisibility}" Width="10" Height="10" Fill="White" RadiusX="2" RadiusY="2"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               HorizontalOffset="-258"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA" BorderBrush="#BCC3D4" BorderThickness="1" Padding="12" Width="300">
                <StackPanel>
                    <TextBlock Text="Robot settings" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Wheel diameter, mm" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                            <TextBox Text="{Binding WheelDiameter, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,3" Margin="0,3,0,0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Wheelbase, mm" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                            <TextBox Text="{Binding WheelBaseWidth, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,3" Margin="0,3,0,0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,3">
                        <TextBlock Text="Robot description" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding RobotDescriptionCounter}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox Text="{Binding RobotDescription, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="800"
                             Height="92"
                             Padding="6,5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="{StaticResource git_panel_separator}"
                             BorderThickness="1"
                             FontFamily="{StaticResource ui_fontfamily}"
                             FontSize="13"
                             Background="#FFFFFF"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
