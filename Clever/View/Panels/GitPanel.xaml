<UserControl x:Class="Clever.View.Panels.GitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="340">
    <UserControl.Resources>
        <Style x:Key="GitSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#414659"/>
            <Setter Property="Margin" Value="8,8,8,4"/>
        </Style>

        <Style x:Key="GitCommitButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource pnl_clc}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource pnl_clc}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0074D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitRoundToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="{StaticResource brk_but_width}"/>
            <Setter Property="Height" Value="{StaticResource brk_but_height}"/>
            <Setter Property="Background" Value="{StaticResource brk_but_bgd}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="18" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource pnl_mot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource pnl_clc_check}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitBranchButton" TargetType="Button" BasedOn="{StaticResource GitRoundToolButton}">
            <Setter Property="Width" Value="118"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

        <Style x:Key="GitGraphCommitButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource git_commit_hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource git_commit_selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GitFileTemplate">
            <Grid Height="24" Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FileType}" Foreground="{Binding IconBrush}" FontFamily="Calibri" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="#414659" FontFamily="Calibri" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Folder}" Foreground="#8F98AB" FontFamily="Calibri" FontSize="12" Margin="6,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontFamily="Calibri" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource git_panel_bgd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Changes" Style="{StaticResource GitSectionHeader}"/>
                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="8,0,8,6"
                         Padding="6,5"
                         BorderThickness="0"
                         FontFamily="Calibri"
                         FontSize="15"
                         Foreground="#414659"
                         Background="#F6F7FA"
                         ToolTip="{Binding Path=GetLocalization[tGitCommitMessage]}"/>
                <Button Command="{Binding CommitCommand}" Style="{StaticResource GitCommitButton}" Margin="8,0,8,0" ToolTip="{Binding Path=GetLocalization[tGitCommit]}">
                    <TextBlock Text="Commit"/>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#8F98AB" FontFamily="Calibri" FontSize="12" Margin="9,5,9,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Changes" Style="{StaticResource GitSectionHeader}" Margin="8,7,8,2"/>
            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource tc_brk_sf}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,6,0">
                <TextBlock Text="{Binding Changes.Count}" Foreground="White" FontFamily="Calibri" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="3,0,5,4">
                <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource GitFileTemplate}"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="2,6,4,6">
                <ItemsControl ItemsSource="{Binding GraphRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding RowHeight}"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Canvas Grid.Row="0" Grid.Column="0" Width="{Binding GraphWidth}" Height="{Binding RowHeight}" ClipToBounds="False">
                                    <ItemsControl ItemsSource="{Binding Segments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Ellipse Width="10" Height="10" Fill="{Binding NodeBrush}" Stroke="{StaticResource git_panel_bgd}" StrokeThickness="2" Canvas.Left="{Binding NodeX}" Canvas.Top="{Binding NodeY}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-5" Y="-5"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Command="{Binding DataContext.ToggleCommitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GitGraphCommitButtonStyle}">
                                    <Button.ToolTip>
                                        <Border Background="#F6F7FA" BorderBrush="#BCC3D4" BorderThickness="1" Padding="10" MaxWidth="300">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Commit.Author}" Foreground="#0A86FF" FontFamily="Calibri" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Commit.TimeText}" Foreground="#777777" FontFamily="Calibri" FontSize="12" Margin="0,1,0,7"/>
                                                <TextBlock Text="{Binding Commit.Message}" Foreground="#414659" FontFamily="Calibri" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Commit.StatsText}" Foreground="#777777" FontFamily="Calibri" FontSize="12" Margin="0,7,0,0"/>
                                                <TextBlock Text="{Binding Commit.ShortHash}" Foreground="#0A86FF" FontFamily="Calibri" FontSize="12" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button.ToolTip>
                                    <Grid Height="{Binding RowHeight}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="#00FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Commit.IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource git_commit_selected}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Commit.Message}" Foreground="#414659" FontFamily="Calibri" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,6,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <ItemsControl ItemsSource="{Binding Commit.RemoteRefs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource git_branch_bgd}" CornerRadius="10" Padding="6,2" Margin="2,0,0,0">
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource git_branch_text}" FontFamily="Calibri" FontSize="12"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Commit.LocalRefs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource git_branch_bgd}" CornerRadius="10" Padding="6,2" Margin="2,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{StaticResource git_icon_branch}" Width="12" Height="12" Margin="0,0,3,0"/>
                                                                <TextBlock Text="{Binding}" Foreground="{StaticResource git_branch_text}" FontFamily="Calibri" FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Commit.Files}" ItemTemplate="{StaticResource GitFileTemplate}" Margin="4,0,0,4">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Commit.IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource tc_brk_st}" Padding="4,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding PullCommand}" ToolTip="{Binding Path=GetLocalization[tGitPull]}">
                    <Image Source="{StaticResource git_icon_pull}" Width="19" Height="19"/>
                </Button>
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding PushCommand}" ToolTip="{Binding Path=GetLocalization[tGitPush]}">
                    <Image Source="{StaticResource git_icon_push}" Width="19" Height="19"/>
                </Button>
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding ReloadCommand}" ToolTip="{Binding Path=GetLocalization[tGitReload]}">
                    <Image Source="{StaticResource git_icon_reload}" Width="19" Height="19"/>
                </Button>
                <Button Style="{StaticResource GitBranchButton}" Command="{Binding SelectBranchCommand}" ToolTip="{Binding Path=GetLocalization[tGitBranch]}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{StaticResource git_icon_branch}" Width="18" Height="18" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding BranchName}" Foreground="#777777" FontFamily="Calibri" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
