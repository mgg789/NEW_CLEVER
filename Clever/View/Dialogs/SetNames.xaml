<Window x:Class="Clever.View.Dialogs.SetNames"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        KeyUp="Window_KeyUp"
        Title="" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Width="540" Height="255">
    <Window.Resources>
        <Style x:Key="dialog_button" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{StaticResource dialog_but_border}" BorderThickness="1" Name="border" CornerRadius="3">
                            <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource dialog_but_mot}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="false">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource dialog_but_mof}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource dialog_but_clc}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="dialog_label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="0" Background="{StaticResource about_bgd}">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="txtFileTitle" Text="New file" Style="{StaticResource dialog_label}" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="136"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtFileName" Text="Filename:" Style="{StaticResource dialog_label}" Grid.Column="0"/>
                    <TextBox x:Name="fileName" Grid.Column="1" Height="26" Margin="0,0,8,0" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Padding="4,3" TextChanged="fileName_TextChanged" KeyUp="fileName_KeyUp"/>
                    <ComboBox x:Name="fileType" Grid.Column="2" Height="26" Margin="0,0,8,0" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" SelectedIndex="0">
                        <ComboBoxItem Content="Program (.bp)" Tag=".bp"/>
                        <ComboBoxItem Content="Module (.bpm)" Tag=".bpm"/>
                        <ComboBoxItem Content="Include (.bpi)" Tag=".bpi"/>
                        <ComboBoxItem Content="Markdown (.md)" Tag=".md"/>
                        <ComboBoxItem Content="Text (.txt)" Tag=".txt"/>
                        <ComboBoxItem Content="Table (.csv)" Tag=".csv"/>
                    </ComboBox>
                    <Button x:Name="butCreateFile" Grid.Column="3" Style="{StaticResource dialog_button}" Click="butCreateFile_Click">
                        <TextBlock x:Name="butTextFile" Text="Create"/>
                    </Button>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="#D6DAE4" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="txtProjectTitle" Text="New project" Style="{StaticResource dialog_label}" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtProjectName" Text="Project name:" Style="{StaticResource dialog_label}" Grid.Column="0"/>
                    <TextBox x:Name="projectName" Grid.Column="1" Height="26" Margin="0,0,8,0" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Padding="4,3" KeyUp="projectName_KeyUp"/>
                    <Button x:Name="butCreateProject" Grid.Column="2" Style="{StaticResource dialog_button}" Click="butCreateProject_Click">
                        <TextBlock x:Name="butTextProject" Text="Create"/>
                    </Button>
                </Grid>
            </StackPanel>

            <Button x:Name="butClose" Grid.Row="4" Style="{StaticResource dialog_button}" Click="butClose_Click" HorizontalAlignment="Right" Width="100" Margin="0,12,0,0">
                <TextBlock x:Name="butTextClose" Text="Cancel"/>
            </Button>
        </Grid>
    </Grid>
</Window>
