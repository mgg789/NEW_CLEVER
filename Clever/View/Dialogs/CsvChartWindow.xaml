<Window x:Class="Clever.View.Dialogs.CsvChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV-график"
        Width="760"
        Height="500"
        MinWidth="420"
        MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Grid Background="#F7F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#D7DCE8" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <TextBlock x:Name="chartTitle" Foreground="#414659" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Width="26" Height="24" Padding="0" Content="×" FontSize="19" FontWeight="SemiBold" Foreground="#667085" Background="Transparent" BorderThickness="0" ToolTip="Закрыть" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D7DCE8" BorderThickness="1" Margin="12" CornerRadius="5">
            <Canvas x:Name="chartCanvas" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
