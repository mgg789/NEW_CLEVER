<Window x:Class="Clever.View.Dialogs.FixBugsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix bugs"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FixBugsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource dialog_but_border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource dialog_but_mof}"/>
            <Setter Property="Foreground" Value="#414659"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource dialog_but_mot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource dialog_but_clc}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProblemCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource about_bgd}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="ProblemsPanel" Grid.Row="0" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Найдены проблемы"
                       FontFamily="{StaticResource ui_fontfamily}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#414659"/>
            <TextBlock Grid.Row="2"
                       Text="Fix bugs исправляет только синтаксис и простые ошибки. Логика программы не меняется."
                       FontFamily="{StaticResource ui_fontfamily}"
                       FontSize="12"
                       Foreground="#777777"
                       TextWrapping="Wrap"/>

            <ListBox x:Name="ProblemsList"
                     Grid.Row="4"
                     ItemContainerStyle="{StaticResource ProblemCard}"
                     BorderBrush="{StaticResource git_panel_separator}"
                     BorderThickness="1"
                     Background="#FFFFFF"
                     Padding="8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource git_panel_separator}"
                                BorderThickness="1"
                                Background="#FFFFFF"
                                CornerRadius="4"
                                Padding="9,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDECEC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFixable}" Value="True">
                                                    <Setter Property="Background" Value="#E7F4EA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FixabilityMark}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource ui_fontfamily}"
                                               FontWeight="Bold"
                                               Foreground="#414659"/>
                                </Border>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Kind}"
                                               FontFamily="{StaticResource ui_fontfamily}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#414659"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FixabilityText}"
                                               Margin="10,0,0,0"
                                               FontFamily="{StaticResource ui_fontfamily}"
                                               FontSize="12"
                                               Foreground="#777777"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding Location}"
                                               Margin="0,2,0,0"
                                               FontFamily="{StaticResource ui_fontfamily}"
                                               FontSize="12"
                                               Foreground="#777777"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding Message}"
                                               Margin="0,3,0,0"
                                               FontFamily="{StaticResource ui_fontfamily}"
                                               FontSize="12"
                                               Foreground="#414659"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Name="ReportPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Отчёт Fix bugs"
                       FontFamily="{StaticResource ui_fontfamily}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#414659"/>
            <TextBlock x:Name="ReportSummaryText"
                       Grid.Row="2"
                       FontFamily="{StaticResource ui_fontfamily}"
                       FontSize="13"
                       Foreground="#414659"
                       TextWrapping="Wrap"/>
            <Border Grid.Row="4"
                    BorderBrush="{StaticResource git_panel_separator}"
                    BorderThickness="1"
                    Background="#FFFFFF"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="UnresolvedTitleText"
                               FontFamily="{StaticResource ui_fontfamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#414659"/>
                    <ListBox x:Name="UnresolvedList"
                             Grid.Row="2"
                             ItemContainerStyle="{StaticResource ProblemCard}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource git_panel_separator}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReportTitle}"
                                                   FontFamily="{StaticResource ui_fontfamily}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#414659"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ReportMessage}"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource ui_fontfamily}"
                                                   FontSize="12"
                                                   Foreground="#777777"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Style="{StaticResource FixBugsButton}"
                    Click="CancelButton_Click"/>
            <Button x:Name="FixAllButton"
                    Content="Исправить всё"
                    Style="{StaticResource FixBugsButton}"
                    Background="#D9ECFF"
                    BorderBrush="#86BFF2"
                    Click="FixAllButton_Click"/>
            <Button x:Name="CloseButton"
                    Content="Закрыть"
                    Style="{StaticResource FixBugsButton}"
                    Visibility="Collapsed"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
