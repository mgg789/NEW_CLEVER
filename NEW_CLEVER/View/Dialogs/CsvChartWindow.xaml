<Window x:Class="NEW_CLEVER.View.Dialogs.CsvChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV-график"
        Width="760"
        Height="500"
        MinWidth="420"
        MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Grid Background="#F7F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#D7DCE8" BorderThickness="0,0,0,1" Padding="14,9">
            <TextBlock x:Name="chartTitle" Foreground="#414659" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D7DCE8" BorderThickness="1" Margin="12" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="154"/>
                </Grid.ColumnDefinitions>
                <Canvas x:Name="chartCanvas" ClipToBounds="True" MouseMove="ChartCanvas_MouseMove" MouseLeave="ChartCanvas_MouseLeave"/>
                <Border Grid.Column="1" Background="#FAFBFE" BorderBrush="#E1E5EE" BorderThickness="1,0,0,0" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="legendPanel"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
