<UserControl x:Class="NEW_CLEVER.View.Panels.GitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="340">
    <UserControl.Resources>
        <Style x:Key="GitSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#414659"/>
            <Setter Property="Margin" Value="8,8,8,4"/>
        </Style>

        <Style x:Key="GitCommitButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource pnl_clc}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource pnl_clc}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0074D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D6DAE4"/>
                                <Setter Property="Foreground" Value="#8F98AB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitPopupPanelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="#ECEDF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#414659"/>
            <Setter Property="FontFamily" Value="{StaticResource ui_fontfamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C9DDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitRoundToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="{StaticResource brk_but_width}"/>
            <Setter Property="Height" Value="{StaticResource brk_but_height}"/>
            <Setter Property="Background" Value="{StaticResource brk_but_bgd}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource pnl_mot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource pnl_clc_check}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource brk_but_bgd}"/>
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitBranchButton" TargetType="Button" BasedOn="{StaticResource GitRoundToolButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="124"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>

        <Style x:Key="GitGraphCommitButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource git_commit_hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource git_commit_selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitPopupIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9E2F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7A8193"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C3CCDC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource pnl_mot}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitInlineIconButton" TargetType="Button" BasedOn="{StaticResource GitPopupIconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="GitFileRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource git_commit_hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource git_commit_selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GitFileTemplate">
            <Button Command="{Binding DataContext.OpenChangeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource GitFileRowButton}">
                <Grid Height="24" Margin="0,1,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBlock Text="{Binding FileType}" Foreground="{Binding IconBrush}" Visibility="{Binding FileTypeVisibility}" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Image Source="{StaticResource git_icon_file}" Visibility="{Binding DefaultFileIconVisibility}" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Margin="6,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="GitCommitFileTemplate">
            <Grid Height="24" Margin="0,1,0,1" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                    <Grid Width="28" Margin="-32,0,4,0">
                        <TextBlock Text="{Binding FileType}" Foreground="{Binding IconBrush}" Visibility="{Binding FileTypeVisibility}" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{StaticResource git_icon_file}" Visibility="{Binding DefaultFileIconVisibility}" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding FileName}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Folder}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Margin="6,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="GitRoot" Background="{StaticResource git_panel_bgd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="115" MinHeight="52"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Visibility="{Binding MainGitVisibility}">
            <StackPanel>
                <TextBlock Text="{Binding Path=GetLocalization[GitChanges]}" Style="{StaticResource GitSectionHeader}"/>
                <Grid Margin="8,0,8,6">
                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Padding="6,5,32,5"
                             BorderThickness="1"
                             BorderBrush="{StaticResource git_panel_separator}"
                             FontFamily="{StaticResource ui_fontfamily}"
                             FontSize="15"
                             Foreground="#414659"
                             Background="#FFFFFF"
                             ToolTip="{Binding Path=GetLocalization[tGitCommitMessage]}"/>
                    <Button Command="{Binding GenerateCommitMessageCommand}"
                            Style="{StaticResource GitInlineIconButton}"
                            Visibility="{Binding AiGenerateVisibility}"
                            IsEnabled="{Binding IsAiGenerateEnabled}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            ToolTip="{Binding AiGenerateToolTip}">
                        <Grid Width="12" Height="12">
                            <Image Source="{StaticResource ai_icon_generate}"
                                   Width="12"
                                   Height="12"
                                   Visibility="{Binding AiGenerateIconVisibility}"/>
                            <Grid Width="12"
                                  Height="12"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="AiCommitSpinnerStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="AiCommitSpinnerStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Width="11"
                                         Height="11"
                                         Stroke="#0A86FF"
                                         StrokeThickness="1.5"
                                         StrokeDashArray="4 2"/>
                            </Grid>
                        </Grid>
                    </Button>
                </Grid>
                <Button Command="{Binding GitActionCommand}"
                        Style="{StaticResource GitCommitButton}"
                        Margin="8,0,8,0"
                        Background="{Binding GitActionButtonBackground}"
                        Foreground="{Binding GitActionButtonForeground}"
                        IsEnabled="{Binding IsGitActionButtonEnabled}"
                        ToolTip="{Binding GitActionButtonToolTip}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{StaticResource git_icon_action_check}" Width="15" Height="15" Margin="0,0,6,0" Visibility="{Binding GitCommitActionIconVisibility}"/>
                        <Image Source="{StaticResource git_icon_action_cloud}" Width="16" Height="16" Margin="0,0,6,0" Visibility="{Binding GitRemoteActionIconVisibility}"/>
                        <Image Source="{StaticResource git_icon_action_sync}" Width="15" Height="15" Margin="0,0,6,0" Visibility="{Binding GitSyncActionIconVisibility}"/>
                        <Image Source="{StaticResource git_icon_action_arrow_down}" Width="15" Height="15" Margin="0,0,6,0" Visibility="{Binding GitPullActionIconVisibility}"/>
                        <TextBlock Text="{Binding GitActionButtonText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{Binding GitSyncCountersVisibility}" VerticalAlignment="Center">
                            <Image Source="{StaticResource git_icon_action_arrow_up}" Width="12" Height="12" Margin="0,1,2,0"/>
                            <TextBlock Text="{Binding GitOutgoingCommitCount}" FontSize="12" VerticalAlignment="Center"/>
                            <Image Source="{StaticResource git_icon_action_arrow_down}" Width="12" Height="12" Margin="7,1,2,0"/>
                            <TextBlock Text="{Binding GitIncomingCommitCount}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#8F98AB" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Margin="9,5,9,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,0" Visibility="{Binding MainGitVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Path=GetLocalization[GitChanges]}" Style="{StaticResource GitSectionHeader}" Margin="8,7,8,2"/>
            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource tc_brk_sf}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,6,0">
                <TextBlock Text="{Binding Changes.Count}" Foreground="White" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0,0,0,1" Visibility="{Binding MainGitVisibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="3,0,5,4">
                <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource GitFileTemplate}"/>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="3"
                      Visibility="{Binding MainGitVisibility}"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#00FFFFFF"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ShowsPreview="True">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="{TemplateBinding Background}">
                                    <Border Height="1" Background="{StaticResource git_panel_separator}" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#24CFD4E3"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Border Grid.Row="4" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="0" ClipToBounds="True" Visibility="{Binding MainGitVisibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,6,4,6" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding GraphRows}" HorizontalAlignment="Stretch" ClipToBounds="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleCommitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource GitGraphCommitButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        MouseEnter="GraphCommitButton_MouseEnter"
                                        MouseLeave="GraphCommitButton_MouseLeave">
                                <Grid Height="{Binding RowHeight}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="#00FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Commit.IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource git_commit_selected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Grid.Column="0" Width="{Binding GraphWidth}" Height="{Binding RowHeight}" ClipToBounds="False">
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Ellipse Width="10" Height="10" Fill="{Binding NodeBrush}" Stroke="{StaticResource git_panel_bgd}" StrokeThickness="2" Canvas.Left="{Binding NodeX}" Canvas.Top="{Binding NodeY}">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="-5" Y="-5"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Canvas>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding CommitHeight}"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MaxWidth="250"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Commit.Message}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,6,0"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Commit.Markers}" MaxWidth="250" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,0,0,0">
                                                            <Grid Width="18" Height="18" ToolTip="{Binding Text}" Visibility="{Binding HeadVisibility}">
                                                                <Ellipse Width="18" Height="18" Stroke="{Binding Brush}" StrokeThickness="2" Fill="#FFFFFF"/>
                                                                <Ellipse Width="10" Height="10" Stroke="{Binding Brush}" StrokeThickness="2" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Ellipse Width="4" Height="4" Fill="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" ToolTip="{Binding Text}" Visibility="{Binding RemoteVisibility}">
                                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Data="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" Stroke="#FFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </Border>
                                                            <Border Background="{Binding Brush}" CornerRadius="10" Padding="6,2" ToolTip="{Binding Text}" Visibility="{Binding BranchVisibility}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,0,3,0">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Data="M15,6A9,9 0,0 0,6,15L6,3" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/>
                                                                            <Ellipse Canvas.Left="15" Canvas.Top="3" Width="6" Height="6" Stroke="#FFFFFF" StrokeThickness="2" Fill="{x:Null}"/>
                                                                            <Ellipse Canvas.Left="3" Canvas.Top="15" Width="6" Height="6" Stroke="#FFFFFF" StrokeThickness="2" Fill="{x:Null}"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{Binding Text}" Foreground="#FFFFFF" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" MaxWidth="96" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource GitInlineIconButton}"
                                                        Command="{Binding DataContext.RevertCommitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Commit}"
                                                        Click="CommitRowActionButton_Click"
                                                        ToolTip="{Binding Path=DataContext.GetLocalization[tGitRevertCommit], RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Image Source="{StaticResource git_icon_revert}" Width="20" Height="20"/>
                                                </Button>
                                                <Button Style="{StaticResource GitInlineIconButton}"
                                                        Command="{Binding DataContext.DiffCommitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Commit}"
                                                        Click="CommitRowActionButton_Click"
                                                        ToolTip="{Binding Path=DataContext.GetLocalization[tGitDiffCommit], RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Image Source="{StaticResource git_icon_diff}" Width="20" Height="20"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Commit.Files}" ItemTemplate="{StaticResource GitCommitFileTemplate}" Margin="4,0,6,4">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Commit.IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="5" Background="#FFFFFF" Padding="10,1,0,10" Visibility="{Binding MainGitVisibility}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding PullCommand}" IsEnabled="{Binding RemoteSyncToolsEnabled}" ToolTip="{Binding Path=GetLocalization[tGitPull]}" Margin="0,0,0,0">
                    <Image Source="{StaticResource git_icon_pull}" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding PushCommand}" IsEnabled="{Binding RemoteSyncToolsEnabled}" ToolTip="{Binding Path=GetLocalization[tGitPush]}">
                    <Image Source="{StaticResource git_icon_push}" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding ReloadCommand}" IsEnabled="{Binding LocalToolsEnabled}" ToolTip="{Binding Path=GetLocalization[tGitReload]}">
                    <Image Source="{StaticResource git_icon_reload}" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource GitRoundToolButton}" Command="{Binding OpenMergePopupCommand}" IsEnabled="{Binding LocalToolsEnabled}" ToolTip="{Binding Path=GetLocalization[tGitMerge]}">
                    <Viewbox Width="19" Height="19" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8,6 L12,2 L16,6"
                                  Stroke="{StaticResource git_icon_mof}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{x:Null}"/>
                            <Path Data="M12,2 L12,12.3 C12,13.361 11.579,14.378 10.828,15.172 L4,22"
                                  Stroke="{StaticResource git_icon_mof}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{x:Null}"/>
                            <Path Data="M20,22 L15,17"
                                  Stroke="{StaticResource git_icon_mof}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{x:Null}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="BranchButton" Style="{StaticResource GitBranchButton}" Command="{Binding SelectBranchCommand}" ToolTip="{Binding Path=GetLocalization[tGitBranch]}">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource git_icon_branch}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BranchName}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="6" Visibility="{Binding SetupVisibility}">
            <Button Command="{Binding SetupGitCommand}" Style="{StaticResource GitCommitButton}" Width="190" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsSetupButtonEnabled}" Visibility="{Binding SetupMainButtonVisibility}">
                <TextBlock Text="{Binding SetupButtonText}"/>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SetupProjectButtonsVisibility}">
                <Button Command="{Binding SetupNewProjectCommand}" Style="{StaticResource GitCommitButton}" Width="132" Height="34" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Path=GetLocalization[ProjectNew]}"/>
                </Button>
                <Button Command="{Binding SetupOpenProjectCommand}" Style="{StaticResource GitCommitButton}" Width="132" Height="34">
                    <TextBlock Text="{Binding Path=GetLocalization[tOpenProject]}"/>
                </Button>
            </StackPanel>
        </Grid>

        <Popup x:Name="CommitInfoPopup"
               Placement="Relative"
               HorizontalOffset="-260"
               VerticalOffset="18"
               AllowsTransparency="True"
               StaysOpen="True"
               MouseEnter="CommitInfoPopup_MouseEnter"
               MouseLeave="CommitInfoPopup_MouseLeave">
            <Border Background="#F6F7FA"
                    BorderBrush="#BCC3D4"
                    BorderThickness="1"
                    Padding="10"
                    MinWidth="260"
                    MaxWidth="330">
                <StackPanel>
                    <TextBlock Text="{Binding Commit.Author}" Foreground="#0A86FF" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Commit.TimeText}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Margin="0,1,0,7"/>
                    <TextBlock Text="{Binding Commit.Message}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Commit.StatsText}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" Margin="0,7,0,0"/>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Commit.ShortHash}" Foreground="#0A86FF" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GitPopupIconButton}" Click="RevertCommitButton_Click">
                                <Image Source="{StaticResource git_icon_revert}" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource GitPopupIconButton}" Click="DiffCommitButton_Click">
                                <Image Source="{StaticResource git_icon_diff}" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="BranchPopup"
               PlacementTarget="{Binding ElementName=BranchButton}"
               Placement="Top"
               VerticalOffset="-4"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsBranchPopupOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA"
                    BorderBrush="#BCC3D4"
                    BorderThickness="1"
                    Padding="8"
                    Width="230">
                <StackPanel>
                    <Grid Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Path=GetLocalization[GitBranches]}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{Binding OpenCreateBranchPopupCommand}"
                                Width="24"
                                Height="24"
                                Padding="0"
                                Background="#00FFFFFF"
                                BorderThickness="0"
                                ToolTip="{Binding Path=GetLocalization[tGitCreateBranch]}">
                            <TextBlock Text="+" Foreground="{StaticResource pnl_clc}" FontFamily="{StaticResource ui_fontfamily}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Branches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectBranchItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GitFileRowButton}">
                                    <Grid Height="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Visibility="{Binding ActiveVisibility}" Foreground="{StaticResource pnl_clc}" FontFamily="{StaticResource ui_fontfamily}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource git_icon_branch}" Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource git_panel_separator}" Margin="0,6,0,6"/>
                    <TextBlock Text="{Binding RemoteStatusText}" Visibility="{Binding RemoteConnectedVisibility}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Margin="2,0,2,0" TextTrimming="CharacterEllipsis"/>
                    <Button Command="{Binding OpenRemotePopupCommand}" Visibility="{Binding RemoteConnectVisibility}" Style="{StaticResource GitPopupPanelButton}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Path=GetLocalization[GitConnectRemote]}"/>
                    </Button>
                    <Button Command="{Binding OpenRemotePopupCommand}" Visibility="{Binding RemoteConnectedVisibility}" Style="{StaticResource GitPopupPanelButton}" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Path=GetLocalization[GitRemoteSettings]}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="CreateBranchPopup"
               PlacementTarget="{Binding ElementName=GitRoot}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsCreateBranchPopupOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA"
                    BorderBrush="#BCC3D4"
                    BorderThickness="1"
                    Padding="12"
                    Width="300">
                <StackPanel>
                    <TextBlock Text="{Binding Path=GetLocalization[GitNewBranch]}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Path=GetLocalization[GitBranchName]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                    <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,3,0,10" Padding="6,3" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Foreground="#414659" Background="#FFFFFF"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelCreateBranchCommand}" Style="{StaticResource GitPopupPanelButton}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Path=GetLocalization[winCancel]}"/>
                        </Button>
                        <Button Command="{Binding CreateBranchCommand}" IsEnabled="{Binding IsCreateBranchEnabled}" Style="{StaticResource GitPopupPanelButton}">
                            <TextBlock Text="{Binding Path=GetLocalization[winCreate]}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MergePopup"
               PlacementTarget="{Binding ElementName=GitRoot}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsMergePopupOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA"
                    BorderBrush="#BCC3D4"
                    BorderThickness="1"
                    Padding="12"
                    Width="360">
                <StackPanel>
                    <TextBlock Text="{Binding Path=GetLocalization[GitMergeBranches]}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Path=GetLocalization[GitMergeSourceBranch]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Branches}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Name"
                              SelectedValue="{Binding MergeSourceBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="28"
                              Margin="0,3,0,8"
                              FontFamily="{StaticResource ui_fontfamily}"
                              FontSize="13"/>
                    <TextBlock Text="{Binding Path=GetLocalization[GitMergeTargetBranch]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Branches}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Name"
                              SelectedValue="{Binding MergeTargetBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="28"
                              Margin="0,3,0,12"
                              FontFamily="{StaticResource ui_fontfamily}"
                              FontSize="13"/>
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Command="{Binding CancelMergeCommand}" Style="{StaticResource GitPopupPanelButton}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Path=GetLocalization[winCancel]}"/>
                            </Button>
                            <Button Command="{Binding SoftMergeCommand}" IsEnabled="{Binding IsMergeActionEnabled}" Style="{StaticResource GitPopupPanelButton}">
                                <TextBlock Text="{Binding Path=GetLocalization[GitMergeSoft]}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding MergeUseSourceCommand}" IsEnabled="{Binding IsMergeActionEnabled}" Style="{StaticResource GitPopupPanelButton}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding MergeSourceActionText}"/>
                            </Button>
                            <Button Command="{Binding MergeUseTargetCommand}" IsEnabled="{Binding IsMergeActionEnabled}" Style="{StaticResource GitPopupPanelButton}">
                                <TextBlock Text="{Binding MergeTargetActionText}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MergeConflictPopup"
               PlacementTarget="{Binding ElementName=GitRoot}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="{Binding IsMergeConflictPopupOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA"
                    BorderBrush="#D45B55"
                    BorderThickness="1"
                    Padding="12"
                    Width="380">
                <StackPanel>
                    <TextBlock Text="{Binding Path=GetLocalization[GitMergeConflictTitle]}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MergeConflictMessage}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Command="{Binding CancelConflictMergeCommand}" Style="{StaticResource GitPopupPanelButton}">
                                <TextBlock Text="{Binding Path=GetLocalization[winCancel]}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding MergeUseSourceCommand}" Style="{StaticResource GitPopupPanelButton}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding MergeSourceActionText}"/>
                            </Button>
                            <Button Command="{Binding MergeUseTargetCommand}" Style="{StaticResource GitPopupPanelButton}">
                                <TextBlock Text="{Binding MergeTargetActionText}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="RemotePopup"
               PlacementTarget="{Binding ElementName=GitRoot}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="True"
               Opened="RemotePopup_Opened"
               Closed="RemotePopup_Closed"
               IsOpen="{Binding IsRemotePopupOpen, Mode=TwoWay}">
            <Border Background="#F6F7FA"
                    BorderBrush="#BCC3D4"
                    BorderThickness="1"
                    Padding="12"
                    Width="320">
                <StackPanel>
                    <TextBlock Text="{Binding Path=GetLocalization[GitConnectRemote]}" Foreground="#414659" FontFamily="{StaticResource ui_fontfamily}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Path=GetLocalization[GitRemoteUrl]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                    <TextBox Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,3,0,8" Padding="6,3" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Foreground="#414659" Background="#FFFFFF"/>

                    <TextBlock Text="{Binding RemotePopupStatusMessage}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding RemoteCredentialsVisibility}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="{Binding Path=GetLocalization[GitRemoteLoginPassword]}" IsChecked="{Binding UseLoginPasswordAuth}" GroupName="GitRemoteAuth" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Foreground="#414659" Margin="0,0,12,0"/>
                            <RadioButton Content="{Binding Path=GetLocalization[GitRemoteToken]}" IsChecked="{Binding UseTokenAuth}" GroupName="GitRemoteAuth" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Foreground="#414659"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Path=GetLocalization[GitRemoteLogin]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                        <TextBox Text="{Binding RemoteLogin, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,3,0,7" Padding="6,3" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>

                        <StackPanel Visibility="{Binding LoginPasswordVisibility}">
                            <TextBlock Text="{Binding Path=GetLocalization[GitRemotePassword]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                            <PasswordBox x:Name="RemotePasswordBox" PasswordChanged="RemotePasswordBox_PasswordChanged" Height="28" Margin="0,3,0,8" Padding="6,3" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding TokenVisibility}">
                            <TextBlock Text="{Binding Path=GetLocalization[GitRemoteTokenField]}" Foreground="#777777" FontFamily="{StaticResource ui_fontfamily}" FontSize="12"/>
                            <PasswordBox x:Name="RemoteTokenBox" PasswordChanged="RemoteTokenBox_PasswordChanged" Height="28" Margin="0,3,0,8" Padding="6,3" BorderBrush="{StaticResource git_panel_separator}" BorderThickness="1" FontFamily="{StaticResource ui_fontfamily}" FontSize="13" Background="#FFFFFF"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RemoteCancelCommand}" Style="{StaticResource GitCommitButton}" Width="82" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Path=GetLocalization[winCancel]}"/>
                        </Button>
                        <Button Command="{Binding RemoteDisconnectCommand}" Visibility="{Binding RemoteDisconnectVisibility}" Style="{StaticResource GitCommitButton}" Width="92" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Path=GetLocalization[GitRemoteDisconnect]}"/>
                        </Button>
                        <Button Command="{Binding RemoteCheckCommand}" Visibility="{Binding RemoteCheckVisibility}" Style="{StaticResource GitCommitButton}" Width="82" Height="28">
                            <TextBlock Text="{Binding Path=GetLocalization[GitRemoteCheck]}"/>
                        </Button>
                        <Button Command="{Binding RemoteConnectCommand}" Visibility="{Binding RemoteConnectSubmitVisibility}" IsEnabled="{Binding IsRemoteConnectSubmitEnabled}" Style="{StaticResource GitCommitButton}" Width="92" Height="28">
                            <TextBlock Text="{Binding Path=GetLocalization[GitRemoteConnect]}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
