<UserControl x:Class="NEW_CLEVER.View.Controls.Buttons.EditButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NEW_CLEVER.View.Controls.Buttons"
             xmlns:edit_but="clr-namespace:NEW_CLEVER.View.Controls.Buttons.EditButtons"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="EditorToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="{StaticResource pnl_but_width}"/>
            <Setter Property="Height" Value="{StaticResource pnl_but_height}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSplitHorizontalImageStyle" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource git_icon_split_horizontal}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="{StaticResource git_icon_split_horizontal_hover}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="{StaticResource git_icon_split_horizontal_pressed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorSplitVerticalImageStyle" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource git_icon_split_vertical}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="{StaticResource git_icon_split_vertical_hover}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="{StaticResource git_icon_split_vertical_pressed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorPanelRightImageStyle" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource git_icon_panel_right}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="{StaticResource git_icon_panel_right_hover}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="{StaticResource git_icon_panel_right_pressed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal">
            <edit_but:ButtonEditSelectAll Margin="5,0,0,0"/>
            <edit_but:ButtonEditCopy Margin="10,0,0,0"/>
            <edit_but:ButtonEditCut Margin="10,0,0,0"/>
            <edit_but:ButtonEditPaste Margin="10,0,0,0"/>
            <Canvas Width="2" Height="{StaticResource pnl_but_height}" Margin="10,0,0,0">
                <Canvas.Background>
                    <DrawingBrush>
                        <DrawingBrush.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V27 H2 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <GeometryDrawing Brush="{StaticResource delimeter}" Geometry="F1 M2,27z M0,0z M1,27C0.5,27,0,26.626,0,26L0,1C0,0.5 0.375,0 1,0 1.625,0 2,0.375 2,1L2,26C2,26.626,1.5,27,1,27z" />
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>
            <edit_but:ButtonEditUndo Margin="10,0,0,0"/>
            <edit_but:ButtonEditRedo Margin="10,0,0,0"/>
            <Canvas Width="2" Height="{StaticResource pnl_but_height}" Margin="10,0,0,0">
                <Canvas.Background>
                    <DrawingBrush>
                        <DrawingBrush.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V27 H2 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <GeometryDrawing Brush="{StaticResource delimeter}" Geometry="F1 M2,27z M0,0z M1,27C0.5,27,0,26.626,0,26L0,1C0,0.5 0.375,0 1,0 1.625,0 2,0.375 2,1L2,26C2,26.626,1.5,27,1,27z" />
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>
            <edit_but:ButtonEditShowNumber Margin="10,0,0,0"/>
            <edit_but:ButtonEditWrap Margin="10,0,0,0"/>
            <edit_but:ButtonEditFormat Margin="10,0,0,0"/>
            <edit_but:ButtonEditShowLine Margin="10,0,0,0"/>
            <edit_but:ButtonEditShowSpace Margin="10,0,0,0"/>
            <Canvas Width="2" Height="{StaticResource pnl_but_height}" Margin="10,0,0,0">
                <Canvas.Background>
                    <DrawingBrush>
                        <DrawingBrush.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V27 H2 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <GeometryDrawing Brush="{StaticResource delimeter}" Geometry="F1 M2,27z M0,0z M1,27C0.5,27,0,26.626,0,26L0,1C0,0.5 0.375,0 1,0 1.625,0 2,0.375 2,1L2,26C2,26.626,1.5,27,1,27z" />
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>
            <Button Style="{StaticResource EditorToolButton}" Margin="10,0,0,0" Command="{Binding SplitSideBySideCommand}" ToolTip="{Binding Path=GetLocalization[tSplitSideBySide]}" AutomationProperties.Name="{Binding Path=GetLocalization[tSplitSideBySide]}">
                <Image Style="{StaticResource EditorSplitHorizontalImageStyle}" Width="17" Height="17"/>
            </Button>
            <Button Style="{StaticResource EditorToolButton}" Margin="10,0,0,0" Command="{Binding SplitTopBottomCommand}" ToolTip="{Binding Path=GetLocalization[tSplitTopBottom]}" AutomationProperties.Name="{Binding Path=GetLocalization[tSplitTopBottom]}">
                <Image Style="{StaticResource EditorSplitVerticalImageStyle}" Width="17" Height="17"/>
            </Button>
            <Button Style="{StaticResource EditorToolButton}" Margin="10,0,0,0" Command="{Binding ToggleRightSidebarCommand}" ToolTip="{Binding Path=GetLocalization[tToggleRightSidebar]}" AutomationProperties.Name="{Binding Path=GetLocalization[tToggleRightSidebar]}">
                <Image Style="{StaticResource EditorPanelRightImageStyle}" Width="17" Height="17"/>
            </Button>
            <Canvas Width="2" Height="{StaticResource pnl_but_height}" Margin="10,0,0,0">
                <Canvas.Background>
                    <DrawingBrush>
                        <DrawingBrush.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V27 H2 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <GeometryDrawing Brush="{StaticResource delimeter}" Geometry="F1 M2,27z M0,0z M1,27C0.5,27,0,26.626,0,26L0,1C0,0.5 0.375,0 1,0 1.625,0 2,0.375 2,1L2,26C2,26.626,1.5,27,1,27z" />
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>
            <edit_but:Find Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
